#!/bin/bash

# omarchy:summary=Save open windows and their workspaces for restore on next boot
# omarchy:args=[--quiet]

set -euo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
MANIFEST="$STATE_DIR/session.json"
TMUX_STATE="$STATE_DIR/tmux-sessions.json"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/session-restore.log"

log() {
  printf '%s save: %s\n' "$(date --iso-8601=seconds)" "$*" >>"$LOG"
}

log "started"

TERMINAL_CLASSES=(Alacritty kitty foot com.mitchellh.ghostty org.wezfurlong.wezterm)
SKIP_CLASSES=(walker)

is_in() {
  local x=$1 i
  shift
  for i in "$@"; do [[ $i == "$x" ]] && return 0; done
  return 1
}

# Print a process's argv as a shell-safe command line
quoted_cmdline() {
  local arg cmd=""
  while IFS= read -r -d '' arg; do cmd+="$(printf '%q' "$arg") "; done <"/proc/$1/cmdline"
  printf '%s' "${cmd% }"
}

# Serialize one tmux session's windows and panes, including what each pane is
# running, so restore can rebuild it after the tmux server dies at shutdown.
tmux_session_json() {
  local session=$1 w_index w_name w_layout w_active p_index p_cwd p_pid p_active fg_pid pane_cmd
  local win_entries=() pane_entries=()

  while IFS=$'\t' read -r w_index w_name w_layout w_active; do
    pane_entries=()
    while IFS=$'\t' read -r p_index p_cwd p_pid p_active; do
      pane_cmd=""
      fg_pid=$(pgrep -P "$p_pid" 2>/dev/null | tail -n1 || true)
      [[ -n $fg_pid && -r /proc/$fg_pid/cmdline ]] && pane_cmd=$(quoted_cmdline "$fg_pid")
      pane_entries+=("$(jq -n \
        --argjson index "$p_index" \
        --arg cwd "$p_cwd" \
        --arg cmd "$pane_cmd" \
        --argjson active "$([[ $p_active == 1 ]] && echo true || echo false)" \
        '{index: $index, cwd: $cwd, cmd: $cmd, active: $active}')")
    done < <(tmux list-panes -t "=$session:$w_index" -F $'#{pane_index}\t#{pane_current_path}\t#{pane_pid}\t#{pane_active}' 2>/dev/null)

    ((${#pane_entries[@]} > 0)) || continue
    win_entries+=("$(jq -n \
      --argjson index "$w_index" \
      --arg name "$w_name" \
      --arg layout "$w_layout" \
      --argjson active "$([[ $w_active == 1 ]] && echo true || echo false)" \
      --argjson panes "$(printf '%s\n' "${pane_entries[@]}" | jq -s '.')" \
      '{index: $index, name: $name, layout: $layout, active: $active, panes: $panes}')")
  done < <(tmux list-windows -t "=$session" -F $'#{window_index}\t#{window_name}\t#{window_layout}\t#{window_active}' 2>/dev/null)

  ((${#win_entries[@]} > 0)) || return 0
  jq -n --arg name "$session" --argjson windows "$(printf '%s\n' "${win_entries[@]}" | jq -s '.')" \
    '{name: $name, windows: $windows}'
}

# Snapshot every session on the tmux server, not only the ones a terminal
# window is attached to, so detached sessions survive the reboot too.
rm -f "$TMUX_STATE"
session_count=0
if command -v tmux &>/dev/null; then
  sessions=()
  while IFS= read -r session; do
    json=$(tmux_session_json "$session")
    [[ -n $json ]] && sessions+=("$json")
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)

  if ((${#sessions[@]} > 0)); then
    printf '%s\n' "${sessions[@]}" | jq -s '.' >"$TMUX_STATE"
    session_count=${#sessions[@]}
  fi
fi

entries=()
seen_pids=" "

while IFS= read -r client; do
  class=$(jq -r '.class' <<<"$client")
  ws=$(jq -r '.workspace.id' <<<"$client")
  floating=$(jq -r '.floating' <<<"$client")
  pid=$(jq -r '.pid' <<<"$client")

  ((ws > 0)) || continue # skip special workspaces (scratchpads)
  ((pid > 0)) || continue
  is_in "$class" "${SKIP_CLASSES[@]}" && continue
  [[ -r /proc/$pid/cmdline ]] || continue

  # Windows sharing a process (e.g. multiple Chromium windows) can only be
  # relaunched once, so keep the first occurrence only.
  [[ $seen_pids == *" $pid "* ]] && continue
  seen_pids+="$pid "

  # Flatpak apps run inside a mount namespace, so /proc/<pid>/cmdline reflects
  # the sandboxed path and isn't launchable from the host. Relaunch via the
  # app id instead, read from the sandbox's own .flatpak-info marker.
  flatpak_id=""
  if [[ -r /proc/$pid/root/.flatpak-info ]]; then
    flatpak_id=$(sed -n 's/^name=//p' /proc/"$pid"/root/.flatpak-info 2>/dev/null | head -n1)
  fi

  if [[ -n $flatpak_id ]]; then
    cmd="flatpak run $(printf '%q' "$flatpak_id")"
  else
    cmd=$(quoted_cmdline "$pid")
    [[ -n $cmd ]] || continue
  fi

  # For terminals, record the shell's working directory, and which tmux
  # session (if any) is attached on that shell's tty so the relaunched
  # terminal reattaches to it.
  cwd=""
  tmux_session=""
  if is_in "$class" "${TERMINAL_CLASSES[@]}"; then
    shell_pid=$(pgrep -P "$pid" 2>/dev/null | tail -n1 || true)
    if [[ -n $shell_pid ]]; then
      dir=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null || true)
      [[ -d $dir ]] && cwd=$dir

      tty=$(ps -o tty= -p "$shell_pid" 2>/dev/null | tr -d '[:space:]')
      if ((session_count > 0)) && [[ -n $tty && $tty != '?' ]]; then
        tmux_session=$(tmux list-clients -F '#{client_tty}'$'\t''#{session_name}' 2>/dev/null |
          awk -F '\t' -v t="/dev/$tty" '$1==t{print $2; exit}')
      fi
    fi
  fi

  entries+=("$(jq -n \
    --arg class "$class" \
    --argjson workspace "$ws" \
    --argjson floating "$floating" \
    --arg cmd "$cmd" \
    --arg cwd "$cwd" \
    --arg tmux_session "$tmux_session" \
    '{class: $class, workspace: $workspace, floating: $floating, cmd: $cmd, cwd: $cwd, tmux_session: $tmux_session}')")
done < <(hyprctl clients -j | jq -c '.[]')

if ((${#entries[@]} == 0)); then
  rm -f "$MANIFEST"
  log "no windows found, saved $session_count tmux session(s)"
  [[ ${1:-} == --quiet ]] || echo "No windows to save ($session_count tmux session(s) saved)"
  exit 0
fi

printf '%s\n' "${entries[@]}" | jq -s '.' >"$MANIFEST"

# Snapshot herdr agent panes so omarchy-session-restore-agents can resume them
AGENTS="$STATE_DIR/herdr-agents.json"
agent_count=0
rm -f "$AGENTS"
if command -v herdr &>/dev/null; then
  if agents_json=$(herdr agent list 2>/dev/null) &&
    [[ $(jq '.result.agents | length' <<<"$agents_json" 2>/dev/null || echo 0) -gt 0 ]]; then
    jq '[.result.agents[] | {agent, pane_id, cwd}]' <<<"$agents_json" >"$AGENTS"
    agent_count=$(jq 'length' "$AGENTS")
  fi
fi

log "saved ${#entries[@]} window(s), $session_count tmux session(s) and $agent_count agent(s)"
[[ ${1:-} == --quiet ]] || echo "Saved ${#entries[@]} window(s) and $session_count tmux session(s) to $STATE_DIR"
