#!/bin/bash

# omarchy:summary=Relaunch windows saved by omarchy-session-save onto their workspaces
# omarchy:args=[--dry-run]

set -euo pipefail

SCRIPT_DIR=$(dirname "$(realpath "$0")")
STATE_DIR="$HOME/.local/state/omarchy"
MANIFEST="$STATE_DIR/session.json"
TMUX_STATE="$STATE_DIR/tmux-sessions.json"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/session-restore.log"

# How long a Flatpak app's placement rule stays active. Generous because apps
# like Discord show an updater first and only map their main window after any
# pending update has downloaded.
FLATPAK_RULE_TIMEOUT_MS=120000

log() {
  printf '%s restore: %s\n' "$(date --iso-8601=seconds)" "$*" >>"$LOG"
}

# Only one restore may run at a time: the shell plugin service and the
# post-boot hook can both fire around login. Every process that can outlive
# this script (tmux server, herdr agent resume) must close fd 9, or it keeps
# the lock held and every later restore silently exits here.
exec 9>"$STATE_DIR/session.lock"
flock -n 9 || exit 0

[[ -f $MANIFEST || -f $TMUX_STATE ]] || exit 0

dry_run=false
[[ ${1:-} == --dry-run ]] && dry_run=true

# Wrap a string in a Lua long bracket, which needs no escaping inside
lua_string() {
  local level="="
  while [[ "$1]" == *"]${level}]"* ]]; do level+="="; done
  printf '[%s[%s]%s]' "$level" "$1" "$level"
}

# Rebuild a saved tmux session's windows and panes detached, so the relaunched
# terminal (if any) attaches to the full layout rather than a single shell.
rebuild_tmux_session() {
  local session=$1 windows_json=$2
  local win_count wi pi w w_index w_name w_layout panes pane_count p_cwd p_index p_cmd size created
  local active_window="" active_pane="" args=()

  win_count=$(jq 'length' <<<"$windows_json")
  ((win_count > 0)) || return 1

  for ((wi = 0; wi < win_count; wi++)); do
    w=$(jq -c ".[$wi]" <<<"$windows_json")
    w_index=$(jq -r '.index' <<<"$w")
    w_name=$(jq -r '.name' <<<"$w")
    w_layout=$(jq -r '.layout // ""' <<<"$w")
    panes=$(jq -c '.panes' <<<"$w")
    pane_count=$(jq 'length' <<<"$panes")
    ((pane_count > 0)) || continue
    p_cwd=$(jq -r '.[0].cwd // ""' <<<"$panes")
    [[ -d $p_cwd ]] || p_cwd=$HOME # e.g. a directory that only exists on the other OS
    [[ $(jq -r '.active' <<<"$w") == true ]] && active_window=$w_index

    if ! tmux has-session -t "=$session" 9>&- 2>/dev/null; then
      # Size the detached session like the saved window so splits have room
      args=(-d -s "$session" -n "$w_name" -c "$p_cwd" -P -F '#{window_index}')
      size=${w_layout#*,}
      size=${size%%,*}
      [[ $size =~ ^([0-9]+)x([0-9]+)$ ]] && args+=(-x "${BASH_REMATCH[1]}" -y "${BASH_REMATCH[2]}")
      created=$(tmux new-session "${args[@]}" 9>&-) || return 1
      if [[ $created != "$w_index" ]]; then
        tmux move-window -s "=$session:$created" -t "=$session:$w_index" 9>&- || true
      fi
    else
      tmux new-window -d -t "=$session:$w_index" -n "$w_name" -c "$p_cwd" 9>&- || continue
    fi

    # A split is inserted right after the pane it splits, so splitting the
    # previously created pane each time reproduces the saved pane order.
    for ((pi = 1; pi < pane_count; pi++)); do
      p_cwd=$(jq -r ".[$pi].cwd // \"\"" <<<"$panes")
      [[ -d $p_cwd ]] || p_cwd=$HOME
      p_index=$(jq -r ".[$((pi - 1))].index" <<<"$panes")
      tmux split-window -d -t "=$session:$w_index.$p_index" -c "$p_cwd" 9>&- 2>/dev/null || true
    done
    if [[ -n $w_layout ]]; then
      tmux select-layout -t "=$session:$w_index" "$w_layout" 9>&- 2>/dev/null || true
    fi

    for ((pi = 0; pi < pane_count; pi++)); do
      p_index=$(jq -r ".[$pi].index" <<<"$panes")
      p_cmd=$(jq -r ".[$pi].cmd // \"\"" <<<"$panes")
      if [[ $(jq -r ".[$pi].active" <<<"$panes") == true && $w_index == "$active_window" ]]; then
        active_pane=$p_index
      fi
      if [[ -n $p_cmd ]]; then
        tmux send-keys -t "=$session:$w_index.$p_index" -l -- "$p_cmd" 9>&- 2>/dev/null &&
          tmux send-keys -t "=$session:$w_index.$p_index" Enter 9>&- 2>/dev/null || true
      fi
    done
  done

  tmux has-session -t "=$session" 9>&- 2>/dev/null || return 1
  [[ -n $active_window ]] && tmux select-window -t "=$session:$active_window" 9>&- 2>/dev/null || true
  [[ -n $active_pane ]] && tmux select-pane -t "=$session:$active_window.$active_pane" 9>&- 2>/dev/null || true
  return 0
}

# Flatpak apps map their windows from a bwrap-sandboxed child that Hyprland
# can't tie back to the exec, so the [workspace] exec rule never applies to
# them. Instead, add a temporary window rule matching the app's class: it
# places every window the app maps (updater splash included) at map time,
# keeps it from pulling focus when it activates, and a timer switches it off
# so windows opened later behave normally. The rule and timer are kept in a
# Lua global so they can't be garbage-collected before the timer fires.
flatpak_rule_lua() {
  local class=$1 ws=$2 floating=$3 regex float=""
  regex="^($(sed 's/[][\\.^$*+?(){}|]/\\&/g' <<<"$class"))\$"
  [[ $floating == true ]] && float=", float = true"
  cat <<EOF
_G.session_restore_rules = _G.session_restore_rules or {}
local entry = {}
entry.rule = hl.window_rule({ match = { class = $(lua_string "$regex") }, workspace = $(lua_string "$ws silent"), focus_on_activate = false$float })
entry.timer = hl.timer(function()
  entry.rule:set_enabled(false)
  _G.session_restore_rules[entry] = nil
end, { timeout = $FLATPAK_RULE_TIMEOUT_MS, type = "oneshot" })
_G.session_restore_rules[entry] = true
EOF
}

hypr_eval() {
  if $dry_run; then
    printf 'hyprctl eval %q\n' "$1"
  else
    hyprctl eval "$1" >/dev/null 2>&1
  fi
}

if [[ -f $TMUX_STATE ]] && command -v tmux &>/dev/null; then
  $dry_run || log "started ($(jq 'length' "$TMUX_STATE") tmux session(s))"
  while IFS= read -r saved; do
    name=$(jq -r '.name' <<<"$saved")
    windows=$(jq -c '.windows' <<<"$saved")
    if $dry_run; then
      echo "tmux rebuild $(printf '%q' "$name") ($(jq 'length' <<<"$windows") window(s))"
    elif tmux has-session -t "=$name" 9>&- 2>/dev/null; then
      log "tmux session $name is already running, left untouched"
    elif rebuild_tmux_session "$name" "$windows"; then
      log "rebuilt tmux session $name"
    else
      log "failed to rebuild tmux session $name"
    fi
  done < <(jq -c '.[]' "$TMUX_STATE")
  $dry_run || mv "$TMUX_STATE" "$TMUX_STATE.restored"
fi

if [[ -f $MANIFEST ]]; then
  $dry_run || log "started ($(jq 'length' "$MANIFEST") window(s))"

  launcher=""
  command -v uwsm-app &>/dev/null && launcher="uwsm-app -- "

  while IFS= read -r entry; do
    ws=$(jq -r '.workspace' <<<"$entry")
    class=$(jq -r '.class' <<<"$entry")
    cmd=$(jq -r '.cmd' <<<"$entry")
    cwd=$(jq -r '.cwd' <<<"$entry")
    floating=$(jq -r '.floating' <<<"$entry")
    tmux_session=$(jq -r '.tmux_session // ""' <<<"$entry")

    if [[ -n $tmux_session ]] && command -v tmux &>/dev/null; then
      # Attach to the rebuilt session; -A falls back to creating it if the
      # rebuild failed, so the terminal doesn't open and immediately exit.
      tmux_cmd="tmux new-session -A -s $(printf '%q' "$tmux_session")"
      [[ -d $cwd ]] && tmux_cmd+=" -c $(printf '%q' "$cwd")"
      case "$class" in
      Alacritty | com.mitchellh.ghostty) cmd+=" -e $tmux_cmd" ;;
      org.wezfurlong.wezterm) cmd+=" start -- $tmux_cmd" ;;
      *) cmd+=" $tmux_cmd" ;; # kitty, foot
      esac
    elif [[ -n $cwd ]]; then
      # Terminals: start in the saved working directory
      cmd="sh -c $(printf '%q' "cd $(printf '%q' "$cwd") && exec $cmd")"
    fi

    if [[ $cmd == "flatpak run "* ]]; then
      if hypr_eval "$(flatpak_rule_lua "$class" "$ws" "$floating")"; then
        $dry_run || log "placing $class windows on workspace $ws for $((FLATPAK_RULE_TIMEOUT_MS / 1000))s"
      else
        log "failed to add placement rule for $class"
      fi
    fi

    rules="workspace $ws silent"
    [[ $floating == true ]] && rules+="; float"

    # Hyprland 0.56+ evaluates dispatches as Lua, so issue the exec through
    # hl.dsp.exec_cmd instead of `hyprctl dispatch exec`.
    if hypr_eval "hl.dispatch(hl.dsp.exec_cmd($(lua_string "[$rules] ${launcher}${cmd}")))"; then
      $dry_run || log "launched $class on workspace $ws"
    else
      log "failed to launch $class on workspace $ws"
      exit 1
    fi
    $dry_run || sleep 0.2 # stagger launches so the compositor applies each workspace rule cleanly
  done < <(jq -c '.[]' "$MANIFEST")

  # Consume the manifest so the next boot doesn't relaunch everything again
  $dry_run || mv "$MANIFEST" "$MANIFEST.restored"
fi

$dry_run || log "completed"

# Resume AI agents inside herdr once its relaunched window brings the server up
if [[ -f $STATE_DIR/herdr-agents.json ]]; then
  if $dry_run; then
    "$SCRIPT_DIR/omarchy-session-restore-agents" --dry-run
  else
    setsid -f "$SCRIPT_DIR/omarchy-session-restore-agents" 9>&- >/dev/null 2>&1
  fi
fi
