#!/bin/bash

# omarchy:summary=Relaunch windows saved by omarchy-session-save onto their workspaces
# omarchy:args=[--dry-run]

set -euo pipefail

SCRIPT_DIR=$(dirname "$(realpath "$0")")
MANIFEST="$HOME/.local/state/omarchy/session.json"
mkdir -p "$(dirname "$MANIFEST")"
LOG="${MANIFEST%.json}-restore.log"

log() {
  printf '%s restore: %s\n' "$(date --iso-8601=seconds)" "$*" >>"$LOG"
}

# Only one restore may run at a time: the shell plugin service and the
# post-boot hook can both fire around login.
exec 9>"${MANIFEST%.json}.lock"
flock -n 9 || exit 0

[[ -f $MANIFEST ]] || exit 0

dry_run=false
[[ ${1:-} == --dry-run ]] && dry_run=true

$dry_run || log "started ($(jq 'length' "$MANIFEST") window(s))"

launcher=""
command -v uwsm-app &>/dev/null && launcher="uwsm-app -- "

# Flags each supported terminal uses to run a command instead of its default
# shell, used to reattach tmux sessions in place.
term_exec_flag() {
  case "$1" in
  Alacritty | com.mitchellh.ghostty) printf '%s' "-e" ;;
  org.wezfurlong.wezterm) printf '%s' "start --" ;;
  kitty | foot) printf '%s' "" ;;
  esac
}

# Rebuild every window and pane of a saved tmux session server-side, offline,
# before anything attaches to it. Reattaching with `new-session -A` only
# recreates a single bare shell because the original tmux server (and all its
# other windows/panes) died at reboot; this recreates the full layout instead.
declare -A built_tmux_sessions=()

rebuild_tmux_session() {
  local session=$1 windows_json=$2
  [[ -n ${built_tmux_sessions[$session]:-} ]] && return
  built_tmux_sessions[$session]=1

  local win_count
  win_count=$(jq 'length' <<<"$windows_json")
  ((win_count > 0)) || return

  # `tmux new-session -d` forks a long-lived tmux server when none is running
  # yet; without closing fd 9 here, that server inherits the restore lock and
  # holds it open forever, so every later restore silently no-ops on flock.
  tmux kill-session -t "$session" 9>&- 2>/dev/null || true

  local active_window=0 active_pane=0

  for ((wi = 0; wi < win_count; wi++)); do
    local w panes pane_count w_index w_name w_layout w_active p0_cwd
    w=$(jq -c ".[$wi]" <<<"$windows_json")
    w_index=$(jq -r '.index' <<<"$w")
    w_name=$(jq -r '.name' <<<"$w")
    w_layout=$(jq -r '.layout' <<<"$w")
    w_active=$(jq -r '.active' <<<"$w")
    panes=$(jq -c '.panes' <<<"$w")
    pane_count=$(jq 'length' <<<"$panes")
    ((pane_count > 0)) || continue
    p0_cwd=$(jq -r '.[0].cwd // ""' <<<"$panes")

    if ((wi == 0)); then
      local args=(-d -s "$session" -n "$w_name")
      [[ -n $p0_cwd ]] && args+=(-c "$p0_cwd")
      tmux new-session "${args[@]}" 9>&- || continue
    else
      local args=(-t "$session" -n "$w_name")
      [[ -n $p0_cwd ]] && args+=(-c "$p0_cwd")
      tmux new-window "${args[@]}" 9>&- || continue
    fi
    [[ $w_active == true ]] && active_window=$w_index

    # tmux assigns each new pane the next index in creation order, so
    # splitting in ascending original-index order reproduces the same
    # pane indices used below to address and re-populate them.
    for ((pi = 1; pi < pane_count; pi++)); do
      local p_cwd args
      p_cwd=$(jq -r ".[$pi].cwd // \"\"" <<<"$panes")
      args=(-t "$session:$w_index")
      [[ -n $p_cwd ]] && args+=(-c "$p_cwd")
      tmux split-window "${args[@]}" 9>&- 2>/dev/null
    done

    [[ -n $w_layout && $w_layout != null ]] && tmux select-layout -t "$session:$w_index" "$w_layout" 9>&- 2>/dev/null

    for ((pi = 0; pi < pane_count; pi++)); do
      local p_index p_cmd p_active
      p_index=$(jq -r ".[$pi].index" <<<"$panes")
      p_cmd=$(jq -r ".[$pi].cmd // \"\"" <<<"$panes")
      p_active=$(jq -r ".[$pi].active" <<<"$panes")
      [[ $p_active == true ]] && active_pane=$p_index
      [[ -n $p_cmd ]] && tmux send-keys -t "$session:$w_index.$p_index" "$p_cmd" Enter 9>&- 2>/dev/null
    done
  done

  tmux select-window -t "$session:$active_window" 9>&- 2>/dev/null
  tmux select-pane -t "$session:$active_window.$active_pane" 9>&- 2>/dev/null
}

# Flatpak's `flatpak run` hands the real app off to a bwrap sandbox process,
# which breaks Hyprland's PID-based tracking for the `[workspace N silent]`
# exec rule; combined with Flatpak's slower startup, the window frequently
# lands on whatever workspace is active instead of the saved one. Watch for
# the app's window to appear and explicitly move it once it does.
#
# `before` must be captured by the caller BEFORE the exec dispatch runs, so a
# Flatpak that maps its window unusually fast can't already be in the
# baseline (which would make it permanently invisible to the "new pid" check
# below).
launch_flatpak_workspace_watcher() {
  local app_id=$1 ws=$2 before=$3

  # Runs for up to 15s in the background, past the parent script's own
  # lifetime, so it must not hold the restore lock (fd 9) open that whole time.
  (
    exec 9>&-
    for _ in $(seq 1 50); do
      sleep 0.3
      while IFS=' ' read -r pid cur_ws; do
        [[ -n $pid ]] || continue
        [[ $before == *" $pid "* ]] && continue
        [[ -r /proc/$pid/root/.flatpak-info ]] || continue
        found_id=$(sed -n 's/^name=//p' "/proc/$pid/root/.flatpak-info" 2>/dev/null | head -n1)
        [[ $found_id == "$app_id" ]] || continue
        [[ $cur_ws == "$ws" ]] && exit 0
        # Hyprland 0.56+ evaluates `dispatch <name> <args>` as Lua, so a raw
        # "movetoworkspacesilent ws,pid:N" dispatch fails outright; go through
        # hl.dispatch/hl.get_window instead, matching what the shipped
        # Hyprland/Omarchy lua configs use for this dispatcher. `follow =
        # false` is the actual "don't steal focus" flag here (there is no
        # `silent` key on this dispatcher).
        hyprctl eval "hl.dispatch(hl.dsp.window.move({ window = hl.get_window('pid:$pid'), workspace = '$ws', follow = false }))" >/dev/null 2>&1
        exit 0
      done < <(hyprctl clients -j 2>/dev/null | jq -r '.[] | "\(.pid) \(.workspace.id)"')
    done
  ) &
  disown
}

while IFS= read -r entry; do
  ws=$(jq -r '.workspace' <<<"$entry")
  class=$(jq -r '.class' <<<"$entry")
  cmd=$(jq -r '.cmd' <<<"$entry")
  cwd=$(jq -r '.cwd' <<<"$entry")
  floating=$(jq -r '.floating' <<<"$entry")
  tmux_session=$(jq -r '.tmux_session // ""' <<<"$entry")
  tmux_windows=$(jq -c '.tmux_windows // []' <<<"$entry")

  flatpak_app_id=""
  [[ $cmd == "flatpak run "* ]] && flatpak_app_id=${cmd#flatpak run }
  flatpak_before=" "
  if [[ -n $flatpak_app_id ]] && ! $dry_run; then
    # Snapshot pids before the launch so the watcher can recognize the app's
    # window even if it maps unusually fast.
    while IFS= read -r p; do flatpak_before+="$p "; done < <(hyprctl clients -j | jq -r '.[].pid')
  fi

  if [[ -n $tmux_session ]] && command -v tmux &>/dev/null; then
    $dry_run || rebuild_tmux_session "$tmux_session" "$tmux_windows"
    # Attach to the session that was just rebuilt server-side instead of
    # creating a fresh bare shell.
    tmux_cmd="tmux attach -t $(printf '%q' "$tmux_session")"
    exec_flag=$(term_exec_flag "$class")
    cmd="$cmd${exec_flag:+ $exec_flag} $tmux_cmd"
  elif [[ -n $cwd ]]; then
    # Terminals: start in the saved working directory
    cmd="sh -c $(printf '%q' "cd $(printf '%q' "$cwd") && exec $cmd")"
  fi

  rules="workspace $ws silent"
  [[ $floating == true ]] && rules+="; float"
  exec_arg="[$rules] ${launcher}${cmd}"

  # Hyprland 0.56+ evaluates dispatches as Lua, so issue the exec through
  # hl.dsp.exec_cmd with a long-bracket string that needs no escaping.
  level="="
  while [[ $exec_arg == *"]${level}]"* ]]; do level+="="; done
  lua="hl.dispatch(hl.dsp.exec_cmd([${level}[${exec_arg}]${level}]))"

  if $dry_run; then
    echo "hyprctl eval '$lua'"
  else
    if hyprctl eval "$lua" >/dev/null; then
      log "launched $class on workspace $ws"
      [[ -n $flatpak_app_id ]] && launch_flatpak_workspace_watcher "$flatpak_app_id" "$ws" "$flatpak_before"
    else
      log "failed to launch $class on workspace $ws"
      exit 1
    fi
    sleep 0.2 # stagger launches so the compositor applies each workspace rule cleanly
  fi
done < <(jq -c '.[]' "$MANIFEST")

# Consume the manifest so the next boot doesn't relaunch everything again
$dry_run || mv "$MANIFEST" "$MANIFEST.restored"
$dry_run || log "completed"

# Resume AI agents inside herdr once its relaunched window brings the server up
if [[ -f $HOME/.local/state/omarchy/herdr-agents.json ]]; then
  if $dry_run; then
    "$SCRIPT_DIR/omarchy-session-restore-agents" --dry-run
  else
    setsid -f "$SCRIPT_DIR/omarchy-session-restore-agents" 9>&- >/dev/null 2>&1
  fi
fi
